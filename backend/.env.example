# Plantilla de configuración local del backend. Cópiala como backend/.env (ignorado por Git) y completa tus valores.
# Spring Boot lo carga al arrancar desde la carpeta backend/ (spring.config.import en application.properties).
# Solo valores de ejemplo para tu MySQL LOCAL. Nunca pongas aquí credenciales de RDS.

# Base de datos de la aplicación (MySQL 8.0 local, base "hellofriend").
DB_URL=jdbc:mysql://localhost:3306/hellofriend?characterEncoding=utf8mb4&connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true&allowPublicKeyRetrieval=true
DB_USER=hellofriend
DB_PASSWORD=cambiar-por-tu-clave-local

# Base de las pruebas de integración (mvnw verify). Debe ser distinta de la anterior: termina en _test y es local.
TEST_DB_URL=jdbc:mysql://localhost:3306/hellofriend_test?characterEncoding=utf8mb4&connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true&allowPublicKeyRetrieval=true

# Flyway por Maven (mvnw flyway:info|validate|migrate). OJO: Maven NO lee este archivo; copia estas tres
# variables al entorno de tu terminal (ver docs/guias/base-de-datos.md). Deben apuntar a tu base local.
# FLYWAY_URL=jdbc:mysql://localhost:3306/hellofriend?characterEncoding=utf8mb4&connectionTimeZone=UTC&allowPublicKeyRetrieval=true
# FLYWAY_USER=hellofriend
# FLYWAY_PASSWORD=cambiar-por-tu-clave-local

# Opcionales (tienen valor por defecto para desarrollo).
# PORT=8080
# CORS_ORIGINS=http://localhost:5173
# FLYWAY_LOCATIONS=classpath:db/migration
# JWT_SECRET=cambiar-por-un-secreto-de-al-menos-32-caracteres
# MAIL_HOST=localhost
# MAIL_PORT=1025
