# Plantilla para deploy/.env en la EC2 (ese archivo NO se sube a Git). Cambia todos los valores.

# Contraseñas de MySQL (solo las usan los contenedores; MySQL no está expuesto a internet).
MYSQL_ROOT_PASSWORD=cambiar-root
DB_PASSWORD=cambiar-app

# Secreto del JWT: al menos 32 caracteres. Generar con:  openssl rand -base64 48
JWT_SECRET=cambiar-por-un-secreto-largo

# URL pública del frontend en Vercel (sin / al final).
CORS_ORIGINS=https://tu-proyecto.vercel.app
FRONTEND_URL=https://tu-proyecto.vercel.app

# Solo para una demo: carga usuarios, canales e incidencias de prueba (clave Prueba#2026).
# Quitar en un uso real.
# FLYWAY_LOCATIONS=classpath:db/migration,classpath:db/datos-prueba
