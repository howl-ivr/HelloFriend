# Fin de línea único para todo el repositorio: LF, sin importar el sistema operativo.
# Evita que Git marque como "cambiados" archivos que nadie tocó cuando alguien trabaja desde Windows.
* text=auto eol=lf

# Scripts de Windows: necesitan CRLF para ejecutarse bien en cmd/PowerShell.
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Script de Maven para Linux/macOS y GitHub Actions: debe quedar con LF.
/backend/mvnw text eol=lf

# Binarios: Git no debe tocarlos.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.jar binary
*.woff binary
*.woff2 binary
*.ttf binary
